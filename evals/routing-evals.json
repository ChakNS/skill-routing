{
  "version": 2,
  "description": "Routing regression cases covering positive routes, hard negatives, abstention, direct local-skill matching, cross-domain composition, conditional candidates, and remembered fallback decisions.",
  "cases": [
    {
      "id": "content_xhs_package_zh",
      "slices": ["content", "zh", "pipeline"],
      "prompt": "生成一套小红书图文笔记，包含标题、正文、封面方向和发布清单",
      "expected_route_kind": "pipeline",
      "expected_modules": ["content"],
      "expected_pipelines": {"content": ["xhs_note_package"]},
      "required_stages": ["intake", "title_hook", "visual_direction", "draft", "asset_generation", "handoff"]
    },
    {
      "id": "content_researched_article",
      "slices": ["content", "en", "pipeline", "evidence"],
      "prompt": "Research competitor examples and write an evidence-backed newsletter with sources.",
      "expected_route_kind": "pipeline",
      "expected_modules": ["content"],
      "expected_pipelines": {"content": ["researched_article"]},
      "required_stages": ["research", "topic", "draft", "handoff"]
    },
    {
      "id": "content_system_zh",
      "slices": ["content", "zh", "pipeline"],
      "prompt": "帮我设计一个内容系统，包括选题库、发布节奏和复盘指标",
      "expected_route_kind": "pipeline",
      "expected_modules": ["content"],
      "expected_pipelines": {"content": ["content_system"]},
      "required_stages": ["strategy", "systemization", "measurement"],
      "required_parallel_groups": ["system_inputs"]
    },
    {
      "id": "coding_skill_development_zh",
      "slices": ["coding", "zh", "skill_tooling"],
      "prompt": "改进这个skill安装器并补测试",
      "expected_route_kind": "pipeline",
      "expected_modules": ["coding"],
      "expected_pipelines": {"coding": ["skill_development"]},
      "required_stages": ["design", "test_authoring", "implementation", "handoff"]
    },
    {
      "id": "coding_frontend_ui",
      "slices": ["coding", "en", "frontend"],
      "prompt": "Redesign this React settings page and verify the mobile layout in browser.",
      "expected_route_kind": "pipeline",
      "expected_modules": ["coding"],
      "expected_pipelines": {"coding": ["frontend_ui_change"]},
      "required_stages": ["context_scan", "design", "test_authoring", "implementation", "browser_verification", "visual_qa"]
    },
    {
      "id": "coding_bug_fix",
      "slices": ["coding", "en", "debugging"],
      "prompt": "The login test is failing after the auth refactor. Find the root cause and fix it.",
      "expected_route_kind": "pipeline",
      "expected_modules": ["coding"],
      "expected_pipelines": {"coding": ["bug_fix"]},
      "required_stages": ["debugging", "test_authoring", "implementation", "handoff"]
    },
    {
      "id": "http_post_endpoint",
      "slices": ["coding", "hard_negative", "word_sense"],
      "prompt": "Add a POST endpoint to the API and include unit tests.",
      "expected_route_kind": "pipeline",
      "expected_modules": ["coding"],
      "expected_pipelines": {"coding": ["backend_data_change", "feature_from_idea", "test_quality"]},
      "forbidden_modules": ["content"],
      "forbidden_pipelines": ["social_post_from_notes"]
    },
    {
      "id": "full_page_screenshot",
      "slices": ["content", "hard_negative", "visual"],
      "prompt": "Create a shareable full-page screenshot of this prototype.",
      "expected_route_kind": "pipeline",
      "expected_modules": ["content"],
      "expected_pipelines": {"content": ["visual_asset_package"]},
      "required_stages": ["visual_direction", "asset_generation", "handoff"]
    },
    {
      "id": "capital_substring_abstain",
      "slices": ["hard_negative", "abstain", "word_boundary"],
      "prompt": "What is the capital of France?",
      "expected_route_kind": "abstain",
      "expected_matched": false,
      "forbidden_modules": ["coding", "content"]
    },
    {
      "id": "negated_deploy",
      "slices": ["hard_negative", "abstain", "negation"],
      "prompt": "Do not deploy anything; only explain the release checklist.",
      "expected_route_kind": "abstain",
      "expected_matched": false,
      "forbidden_pipelines": ["release_pr_deploy"]
    },
    {
      "id": "direct_local_humanizer",
      "slices": ["direct", "personalization", "zh", "cross_language"],
      "prompt": "请把这篇中文 AI 技术文章改得更自然，去掉机器味但保留术语准确性",
      "inventory": [
        {
          "name": "humanizer-tech-zh",
          "description": "Use when Chinese technical or AI writing should sound natural and less machine-generated while preserving precise terminology."
        }
      ],
      "expected_route_kind": "direct",
      "required_selected_skills": ["humanizer-tech-zh"],
      "min_confidence": 0.2
    },
    {
      "id": "direct_newsletter_parser_tests",
      "slices": ["direct", "personalization", "hard_negative", "coding"],
      "prompt": "Write unit tests for a newsletter parser and fix its failing edge cases",
      "inventory": [
        {
          "name": "test-driven-development",
          "description": "Use when implementing unit tests, regression tests, parsers, and testable software behavior."
        }
      ],
      "expected_route_kinds": ["direct", "pipeline"],
      "expected_modules": ["coding"],
      "required_selected_skills": ["test-driven-development"],
      "forbidden_modules": ["content"]
    },
    {
      "id": "composed_content_web_app",
      "slices": ["multi_intent", "coding", "content", "en"],
      "prompt": "Build a React content calendar web app and write the launch post",
      "expected_route_kind": "composed_pipeline",
      "expected_modules": ["coding", "content"],
      "expected_pipelines": {
        "coding": ["frontend_ui_change", "feature_from_idea"],
        "content": ["content_system", "social_post_from_notes"]
      }
    },
    {
      "id": "router_management_stays_main",
      "slices": ["management", "hard_negative", "zh"],
      "prompt": "重新扫描本地 skills，检查路由冲突并更新我的 skill routing",
      "expected_route_kind": "management",
      "expected_matched": true,
      "forbidden_modules": ["coding", "content"]
    },
    {
      "id": "database_index_backend",
      "slices": ["coding", "backend", "recall"],
