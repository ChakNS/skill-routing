    },
    {
      "id": "commit_only_selects_commit_skill",
      "slices": ["coding", "conditional_candidate", "release"],
      "prompt": "Commit the current verified changes. Do not open a PR or deploy.",
      "inventory": [
        {"name": "git-commit", "description": "Use when the user explicitly asks to create a git commit."},
        {"name": "github-pr-creation", "description": "Use when the user explicitly asks to open a GitHub pull request."},
        {"name": "deploy-to-vercel", "description": "Use when the user explicitly asks to deploy to Vercel."}
      ],
      "expected_route_kind": "pipeline",
      "expected_modules": ["coding"],
      "expected_pipelines": {"coding": ["release_pr_deploy"]},
      "required_selected_skills": ["git-commit"],
      "forbidden_selected_skills": ["github-pr-creation", "deploy-to-vercel"]
    },
    {
      "id": "missing_skill_remembered_fallback",
      "slices": ["content", "missing_dependency", "adaptation"],
      "prompt": "生成一套小红书图文笔记，包含标题、正文和封面",
      "initialize": true,
      "resolutions": [
        {
          "module": "content",
          "stage": "title_hook",
          "skill": "hook-generator",
          "action": "fallback"
        }
      ],
      "expected_route_kind": "pipeline",
      "expected_modules": ["content"],
      "expected_pipelines": {"content": ["xhs_note_package"]},
      "expected_stage_status": {"content:title_hook": "agent_fallback"}
    },
    {
      "id": "missing_skill_remembered_replacement",
      "slices": ["content", "missing_dependency", "adaptation", "personalization"],
      "prompt": "生成一套小红书图文笔记，包含标题、正文和封面",
      "inventory": [
        {"name": "my-title-tool", "description": "Use for a private editorial workflow."}
      ],
      "resolutions": [
        {
          "module": "content",
          "stage": "title_hook",
          "skill": "hook-generator",
          "action": "replace",
          "replacement": "my-title-tool"
        }
      ],
      "expected_route_kind": "pipeline",
      "expected_modules": ["content"],
      "required_selected_skills": ["my-title-tool"],
      "expected_stage_status": {"content:title_hook": "selected"}
    },
    {
      "id": "generic_backend_does_not_force_supabase",
      "slices": ["coding", "backend", "conditional_candidate"],
      "prompt": "Add an authentication endpoint to our existing FastAPI service.",
