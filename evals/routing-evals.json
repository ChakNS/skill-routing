    {
      "id": "social_post_includes_hook",
      "slices": ["content", "en", "fixture_parity"],
      "prompt": "Turn these messy notes into a LinkedIn post and give me three hooks.",
      "expected_route_kind": "pipeline",
      "expected_modules": ["content"],
