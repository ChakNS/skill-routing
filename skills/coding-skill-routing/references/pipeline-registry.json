{
  "version": 3,
  "router": "coding-skill-routing",
  "layers": [
    {"id": "intake", "label": "Intake", "purpose": "Clarify repository, acceptance criteria, risk boundaries, and write permissions."},
    {"id": "intelligence", "label": "Codebase Intelligence", "purpose": "Inspect project rules, architecture, dependency paths, and impact areas."},
    {"id": "design", "label": "Design", "purpose": "Choose architecture, UX, API, data, or skill design before writing."},
    {"id": "build", "label": "Build", "purpose": "Modify code, tests, docs, scripts, registries, and configuration."},
    {"id": "quality", "label": "Quality", "purpose": "Run tests, browser checks, visual QA, security review, and verification."},
    {"id": "release", "label": "Release", "purpose": "Prepare handoff, commits, PRs, CI checks, deployment, and rollback notes."}
  ],
  "stages": [
    {"id": "intake", "layer": "intake", "purpose": "Clarify goal, repository, risk, acceptance criteria, and write boundaries."},
    {"id": "context_scan", "layer": "intelligence", "purpose": "Inspect project rules, codebase structure, existing patterns, and related files."},
    {"id": "design", "layer": "design", "purpose": "Choose architecture, UX, API, data, or skill-design approach."},
    {"id": "plan", "layer": "design", "purpose": "Write a durable implementation plan when the task is multi-step."},
    {"id": "implementation", "layer": "build", "purpose": "Edit code, docs, schemas, tests, scripts, or configuration."},
    {"id": "debugging", "layer": "quality", "purpose": "Reproduce failures, isolate root cause, and validate fixes."},
    {"id": "test_authoring", "layer": "quality", "purpose": "Create or update unit, integration, E2E, or regression tests."},
    {"id": "browser_verification", "layer": "quality", "purpose": "Run browser automation or screenshots for web app behavior."},
    {"id": "visual_qa", "layer": "quality", "purpose": "Check responsive UI, layout, screenshots, and visual acceptance."},
    {"id": "security_review", "layer": "quality", "purpose": "Scan security-sensitive diffs, threat models, or vulnerabilities."},
    {"id": "release", "layer": "release", "purpose": "Prepare commits, PRs, CI checks, deployment, and rollback notes."},
    {"id": "handoff", "layer": "release", "purpose": "Summarize files changed, verification, risks, and next steps."}
  ],
